{
  "name": "gateway",
  "version": "0.1.0",
  "private": true,
  "description": "A configuration-driven HTTP gateway built with Fastify",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.25.0",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test eslint.config.js"
  },
  "dependencies": {
    "@fastify/env": "7.0.1",
    "@fastify/helmet": "13.1.2",
    "@fastify/http-proxy": "11.6.4",
    "@fastify/rate-limit": "11.2.1",
    "@sinclair/typebox": "0.34.52",
    "dotenv": "17.2.3",
    "fastify": "5.12.6",
    "jose": "6.2.12",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.10.1",
    "eslint": "10.12.0",
    "pino-pretty": "13.2.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.4"
  }
}
